        "SELECT TIMESTAMP_ADD('HOUR', 2, '2023-01-01 10:00:00') -- Returns '2023-01-01 12:00:00'",
        "SELECT TIMESTAMP_ADD('MINUTE', 30, CURRENT_TIMESTAMP) -- Adds 30 minutes"
      ]
    },
