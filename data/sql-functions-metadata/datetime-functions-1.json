      "sqlKind": "OTHER_FUNCTION",
      "category": "USER_DEFINED_FUNCTION",
      "returnType": "DOUBLE NULLABLE",
      "parameters": {
        "count": "0, 1, or 2",
        "types": "[TIMESTAMP/STRING], [STRING]",
        "description": "Optional timestamp and format string"
      },
      "description": "Returns the Unix timestamp (seconds since 1970-01-01)",
      "aliases": [],
      "examples": [
        "SELECT UNIX_TIMESTAMP() -- Current Unix timestamp",
        "SELECT UNIX_TIMESTAMP('2023-01-01 00:00:00') -- Returns 1672531200"
      ]
    },
