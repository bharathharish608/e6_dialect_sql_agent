      "category": "TIMEDATE",
      "returnType": "Same as input, nullable",
      "parameters": {
        "count": "2",
        "types": "TIMESTAMP, STRING",
        "description": "Timestamp, date part to truncate to"
      },
      "description": "Truncates a timestamp to a specified precision",
      "aliases": [],
      "examples": [
        "SELECT TRUNC('2023-01-15 10:30:00', 'DAY') -- Returns '2023-01-15 00:00:00'",
        "SELECT TRUNC(CURRENT_TIMESTAMP, 'YEAR') -- Truncates to start of year"
