    {
      "name": "DATE_ADD",
      "sqlKind": "DATE_ADD",
      "category": "TIMEDATE",
      "returnType": "TIMESTAMP or DATE NULLABLE",
      "parameters": {
        "count": "2 or 3",
        "types": "TIMESTAMP/DATE, INTEGER or STRING, INTEGER, TIMESTAMP",
        "description": "Date/timestamp, interval amount, or (interval unit, amount, date)"
      },
      "description": "Adds an interval to a date or timestamp",
      "aliases": ["DATEADD"],
      "examples": [
        "SELECT DATE_ADD(CURRENT_DATE, 7) -- Adds 7 days",
        "SELECT DATE_ADD('DAY', 7, '2023-01-01') -- Adds 7 days to date"
      ]
    },
    {
      "name": "DATEADD",
      "sqlKind": "DATE_ADD",
      "category": "TIMEDATE",
      "returnType": "TIMESTAMP NULLABLE",
      "parameters": {
        "count": "3",
        "types": "STRING, INTEGER, TIMESTAMP",
        "description": "Interval unit, amount, date/timestamp"
      },
      "description": "Adds an interval to a date or timestamp (SQL Server compatible)",
      "aliases": ["DATE_ADD"],
      "examples": [
        "SELECT DATEADD('month', 3, '2023-01-01') -- Adds 3 months",
        "SELECT DATEADD('hour', -2, CURRENT_TIMESTAMP) -- Subtracts 2 hours"
      ]
    },
    {
      "name": "DATE_SUB",
      "sqlKind": "DATE_SUB",
      "category": "TIMEDATE",
      "returnType": "DATE NULLABLE",
      "parameters": {
        "count": "2",
