        "description": "Date, number of days to subtract"
      },
      "description": "Subtracts days from a date",
      "aliases": [],
      "examples": [
        "SELECT DATE_SUB('2023-01-15', 7) -- Returns '2023-01-08'",
        "SELECT DATE_SUB(CURRENT_DATE, 30) -- 30 days ago"
      ]
    },
    {
      "name": "DATE_DIFF",
      "sqlKind": "DATE_DIFF",
      "category": "TIMEDATE",
      "returnType": "BIGINT NULLABLE",
      "parameters": {
        "count": "3",
        "types": "STRING, DATE/TIMESTAMP, DATE/TIMESTAMP",
        "description": "Date part, start date, end date"
      },
      "description": "Returns the difference between two dates",
      "aliases": ["DATEDIFF"],
      "examples": [
        "SELECT DATE_DIFF('DAY', '2023-01-01', '2023-01-15') -- Returns 14",
        "SELECT DATE_DIFF('MONTH', '2023-01-01', '2023-06-01') -- Returns 5"
      ]
    },
    {
      "name": "DATEDIFF",
      "sqlKind": "DATEDIFF",
      "category": "TIMEDATE",
      "returnType": "BIGINT NULLABLE",
      "parameters": {
        "count": "2 or 3",
        "types": "DATE/TIMESTAMP, DATE/TIMESTAMP or STRING, DATE/TIMESTAMP, DATE/TIMESTAMP",
        "description": "Two dates or (date part, start date, end date)"
      },
      "description": "Returns the difference between two dates",
      "aliases": ["DATE_DIFF"],
      "examples": [
        "SELECT DATEDIFF('2023-01-15', '2023-01-01') -- Returns 14 (days)",
        "SELECT DATEDIFF('HOUR', '2023-01-01 00:00', '2023-01-01 12:00') -- Returns 12"
      ]
    },
    {
