    {
      "name": "CURRENT_DATE",
      "sqlKind": "OTHER_FUNCTION",
      "category": "TIMEDATE",
      "returnType": "DATE",
      "parameters": {
        "count": "0 or 1",
        "types": "[STRING]",
        "description": "Optional timezone"
      },
      "description": "Returns the current date",
      "aliases": [],
      "examples": [
        "SELECT CURRENT_DATE -- Returns today's date",
        "SELECT CURRENT_DATE('America/New_York') -- Returns current date in New York timezone"
      ]
    },
