    {
      "name": "DATE",
      "sqlKind": "OTHER_FUNCTION",
      "category": "TIMEDATE",
      "returnType": "DATE",
      "parameters": {
        "count": "1",
        "types": "TIMESTAMP/STRING",
        "description": "Timestamp or date string to convert"
      },
      "description": "Extracts the date part from a timestamp or converts string to date",
      "aliases": [],
      "examples": [
        "SELECT DATE('2023-01-15 10:30:00') -- Returns '2023-01-15'",
        "SELECT DATE(CURRENT_TIMESTAMP) -- Returns today's date"
      ]
    },
