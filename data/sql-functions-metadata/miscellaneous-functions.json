      },
      "description": "Extracts values from JSON using JSONPath",
      "aliases": ["JSON_VALUE"],
      "examples": [
        "SELECT JSON_EXTRACT('{\"a\": 1, \"b\": 2}', '$.a') -- Returns 1",
        "SELECT JSON_EXTRACT(json_col, '$.user.name') FROM events"
      ]
